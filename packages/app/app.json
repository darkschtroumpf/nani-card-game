{
  "expo": {
    "name": "The Demon's Cycle",
    "slug": "demons-cycle",
    "owner": "darkschtroumpf",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ward_fire.png",
    "userInterfaceStyle": "dark",
    "scheme": "demonscycle",
    "description": "Protège l'humanité des démons avec des runes magiques. Basé sur le roman The Warded Man de Peter V. Brett.",
    "githubUrl": "https://github.com/darkschtroumpf/nani-card-game",
    "splash": {
      "image": "./assets/images/bg_night.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkschtroumpf.demonscycle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/images/ward_fire.png"
      },
      "package": "com.darkschtroumpf.demonscycle",
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/images/ward_fire.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "543b1bc3-4683-46ba-a964-bbff8818c383"
      },
      "router": {}
    }
  }
}
